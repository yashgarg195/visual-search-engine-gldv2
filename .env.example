# ==============================================================================
# Environment Configuration Template for GLDv2 CLIP + FAISS Pipeline
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Storage & Path Configurations
# Recommended: Point IMAGE_DIR to a local persistent SSD on GCP for high throughput.
# ------------------------------------------------------------------------------
DATA_ROOT=./data
IMAGE_DIR=./data/raw/images
METADATA_DIR=./data/raw/metadata
PROCESSED_DIR=./data/processed
EMBEDDING_DIR=./outputs/embeddings
INDEX_DIR=./outputs/index
EVAL_DIR=./outputs/evaluation

# Whether to automatically download missing official GLDv2 metadata CSVs (train/index labels)
AUTO_DOWNLOAD_METADATA=false

# ------------------------------------------------------------------------------
# Model Configuration (OpenCLIP)
# ViT-B-32 outputs 512-dimensional normalized vectors.
# ------------------------------------------------------------------------------
CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=openai
EMBEDDING_DIM=512
DEVICE=auto
BATCH_SIZE=64
NUM_WORKERS=4

# ------------------------------------------------------------------------------
# Embedding Shard Settings
# ------------------------------------------------------------------------------
SHARD_SIZE=10000

# ------------------------------------------------------------------------------
# FAISS IVF-PQ Index Parameters
# Note: For small test sets (<10,000 images), adjust NLIST down (e.g. 32 to 64)
# so FAISS has sufficient training points per centroid.
# ------------------------------------------------------------------------------
FAISS_NLIST=1024
FAISS_NPROBE=16
FAISS_M=64
FAISS_NBITS=8
FAISS_TRAIN_SAMPLE_SIZE=50000
RANDOM_SEED=42
